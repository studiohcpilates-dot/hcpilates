            { "id": "wd000027", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#F8F3EC;border-radius:8px;padding:2.5rem;'><h3 style='color:#3B2A1E;font-family:Cormorant Garamond,serif;font-size:1.6rem;margin-bottom:1.5rem;'>Como tratamos o Bruxismo</h3><div style='display:flex;gap:1rem;margin-bottom:1.2rem;'><span style='font-size:1.5rem;'>🔍</span><div><h4 style='color:#3B2A1E;font-size:1rem;margin-bottom:.3rem;'>Diagnóstico Diferencial</h4><p style='color:#7A6050;font-size:.85rem;line-height:1.6;'>Avaliação para identificar o tipo, a gravidade e os fatores associados ao bruxismo, diferenciando de outras causas de dor orofacial.</p></div></div><div style='display:flex;gap:1rem;margin-bottom:1.2rem;'><span style='font-size:1.5rem;'>🖐️</span><div><h4 style='color:#3B2A1E;font-size:1rem;margin-bottom:.3rem;'>Fisioterapia Especializada</h4><p style='color:#7A6050;font-size:.85rem;line-height:1.6;'>Terapia manual para alívio da tensão muscular, liberação miofascial e mobilização da ATM.</p></div></div><div style='display:flex;gap:1rem;margin-bottom:1.2rem;'><span style='font-size:1.5rem;'>🧘</span><div><h4 style='color:#3B2A1E;font-size:1rem;margin-bottom:.3rem;'>Exercícios e Reeducação</h4><p style='color:#7A6050;font-size:.85rem;line-height:1.6;'>Protocolo específico para relaxamento e reequilíbrio muscular da face, mandíbula e cervical.</p></div></div><div style='display:flex;gap:1rem;'><span style='font-size:1.5rem;'>💬</span><div><h4 style='color:#3B2A1E;font-size:1rem;margin-bottom:.3rem;'>Trabalho Interdisciplinar</h4><p style='color:#7A6050;font-size:.85rem;line-height:1.6;'>Quando necessário, indicamos e trabalhamos com dentistas e psicólogos para resultado completo.</p></div></div></div>" }, "elements": [] }
