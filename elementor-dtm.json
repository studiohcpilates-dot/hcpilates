            { "id": "wd000009", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#F5EDD6;border-left:3px solid #C9A870;padding:1.2rem 1.8rem;border-radius:0 6px 6px 0;margin-top:1.5rem;'><p style='color:#5C4A3A;'>Se você se identificou com alguma dessas situações, saiba que existe um <strong>caminho diferente</strong>. Um tratamento que não mascara a dor, mas resolve a origem dela.</p></div>" }, "elements": [] },
