            { "id": "wd000021", "elType": "widget", "widgetType": "heading", "settings": { "title": "Mais do que ranger os dentes", "header_size": "h2", "title_color": "#3B2A1E", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 38 } }, "elements": [] },
