            { "id": "wd000011", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#3B2A1E;border-radius:8px;padding:2rem;margin-bottom:1.5rem;'><h3 style='color:#FFFFFF;font-family:Cormorant Garamond,serif;font-size:1.4rem;margin-bottom:1rem;'>O que é a DTM?</h3><p style='color:rgba(255,255,255,.7);font-size:.9rem;line-height:1.7;'>A Disfunção Temporomandibular é uma condição que afeta a articulação temporomandibular (ATM) — a \"dobradiça\" que conecta a mandíbula ao crânio — e os músculos ao redor. Estima-se que <strong style='color:#C9A870;'>entre 40% e 60% da população</strong> apresente algum sinal de DTM ao longo da vida.</p></div>" }, "elements": [] },
            { "id": "wd000012", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#F5EDD6;border-radius:8px;padding:2rem;'><p style='font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B6914;margin-bottom:1rem;'>Sintomas comuns</p><ul style='list-style:none;padding:0;display:flex;flex-direction:column;gap:.6rem;'><li style='color:#5C4A3A;font-size:.9rem;'>• Dor ou sensibilidade na mandíbula, rosto ou têmporas</li><li style='color:#5C4A3A;font-size:.9rem;'>• Dificuldade para abrir ou fechar a boca completamente</li><li style='color:#5C4A3A;font-size:.9rem;'>• Estalos ou crepitação ao mastigar ou bocejar</li><li style='color:#5C4A3A;font-size:.9rem;'>• Dores de cabeça frequentes, especialmente ao acordar</li><li style='color:#5C4A3A;font-size:.9rem;'>• Dor de ouvido sem infecção diagnosticada</li><li style='color:#5C4A3A;font-size:.9rem;'>• Travamento da mandíbula</li><li style='color:#5C4A3A;font-size:.9rem;'>• Sensação de cansaço muscular no rosto</li><li style='color:#5C4A3A;font-size:.9rem;'>• Dor cervical e tensão no pescoço</li><li style='color:#5C4A3A;font-size:.9rem;'>• Sensibilidade dentária sem causa aparente</li></ul></div>" }, "elements": [] }
          ]
        }
      ]
