            { "id": "wd000018", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='width:48px;height:48px;background:#C9A870;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.2rem;color:#3B2A1E;margin-bottom:1.2rem;'>2</div><h3 style='color:#FFFFFF;font-family:Cormorant Garamond,serif;font-size:1.4rem;margin-bottom:.8rem;'>Tratamento Imediato</h3><p style='color:rgba(255,255,255,.6);font-size:.9rem;line-height:1.7;'>Ainda na primeira sessão, já iniciamos. Terapia manual para mobilização articular, liberação miofascial e agulhamento seco (dry needling) quando indicado. A maioria dos pacientes sai com redução dos sintomas.</p><p style='color:#C9A870;font-size:.8rem;margin-top:1rem;'>✓ Resultado desde a 1ª sessão</p>" }, "elements": [] }
        ] },
