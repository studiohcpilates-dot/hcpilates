      "elType": "section",
      "settings": { "layout": "full_width", "background_background": "classic", "background_color": "#F2EDE5", "padding": { "unit": "px", "top": "0", "right": "40", "bottom": "0", "left": "40", "isLinked": false } },
      "elements": [
        { "id": "cf000009", "elType": "column", "settings": { "_column_size": 25, "padding": { "unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false } }, "elements": [
            { "id": "wf000024", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>💊 Remédios e anti-inflamatórios</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Aliviam a dor temporariamente, mas não corrigem o desequilíbrio muscular, postural ou articular que gera o problema. Quando o efeito passa, a dor volta.</p>" }, "elements": [] }
        ] },
        { "id": "cf000010", "elType": "column", "settings": { "_column_size": 25, "padding": { "unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false } }, "elements": [
            { "id": "wf000025", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>🛋️ Repouso prolongado</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>O descanso pode ajudar no curto prazo, mas sem reabilitação ativa, os músculos enfraquecem, as articulações perdem mobilidade e o ciclo de dor se repete.</p>" }, "elements": [] }
        ] },
        { "id": "cf000011", "elType": "column", "settings": { "_column_size": 25, "padding": { "unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false } }, "elements": [
            { "id": "wf000026", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>🤖 Protocolos genéricos</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Sessões em série com os mesmos aparelhos para todo mundo ignoram as particularidades do seu corpo, seu padrão de movimento e sua história de saúde.</p>" }, "elements": [] }
        ] },
        { "id": "cf000012", "elType": "column", "settings": { "_column_size": 25, "padding": { "unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false } }, "elements": [
            { "id": "wf000027", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>📋 Falta de avaliação precisa</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Sem identificar a origem real da disfunção — muscular, articular, postural ou neurológica — qualquer tratamento é uma tentativa no escuro.</p>" }, "elements": [] }
        ] }
      ]
    },
