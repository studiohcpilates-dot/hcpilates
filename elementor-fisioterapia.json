            { "id": "wf000018", "elType": "widget", "widgetType": "image", "settings": { "image": { "url": "" }, "image_size": "full" }, "elements": [] },
            { "id": "wf000019", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#3B2A1E;border-radius:8px;padding:2rem;margin-top:1rem;'><p style='color:#C9A870;font-family:Cormorant Garamond,serif;font-size:1.25rem;line-height:1.7;font-style:italic;'>\"A fisioterapia eficaz não suprime a dor — ela entende por que o corpo dói e reequilibra o que estava fora de lugar.\"</p><p style='color:rgba(255,255,255,.5);font-size:.8rem;margin-top:.8rem;'>— Cinthia Ravenne, Fisioterapeuta</p></div>" }, "elements": [] }
          ]
        }
