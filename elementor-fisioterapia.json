            { "id": "wf000037", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='font-family:Cormorant Garamond,serif;font-size:3.5rem;color:#F5EDD6;line-height:1;'>01</p><h4 style='color:#3B2A1E;font-size:1.1rem;margin-bottom:.8rem;'>Avaliação Funcional Completa</h4><p style='color:#7A6050;font-size:.88rem;line-height:1.8;'>A primeira sessão é dedicada a entender você: sua história de dor, exames, padrão de movimento e compensações. Sem avaliação não existe tratamento eficaz — aqui, não pulamos essa etapa.</p>" }, "elements": [] }
