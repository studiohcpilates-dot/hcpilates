        { "id": "cf000013", "elType": "column", "settings": { "_column_size": 100 }, "elements": [
            { "id": "wf000028", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='text-align:center;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C9A870;'>Especialidades</p>" }, "elements": [] },
            { "id": "wf000029", "elType": "widget", "widgetType": "heading", "settings": { "title": "Áreas de atuação", "header_size": "h2", "title_color": "#FFFFFF", "align": "center", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 42 } }, "elements": [] },
            { "id": "wf000030", "elType": "widget", "widgetType": "divider", "settings": { "color": "#C9A870", "align": "center", "width": { "unit": "px", "size": 60 }, "gap": { "unit": "px", "size": 20 } }, "elements": [] },
            { "id": "wf000031", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='text-align:center;color:rgba(255,255,255,.6);'>Tratamos as principais causas de dor e limitação de movimento com protocolos validados e abordagem individualizada.</p>" }, "elements": [] },
            { "id": "wf000032", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-top:2rem;'><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🦴</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Coluna Vertebral</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Lombalgia, cervicalgia, hérnia de disco, escoliose, espondilose. Tratamento que descomprime, reequilibra e fortalece.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🦵</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Joelhos e Quadril</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Condromalácia, lesão de menisco, bursite trocantérica, artrite e pós-operatório de prótese ou artroscopia.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>💪</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Ombros e Cotovelos</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Tendinite, síndrome do impacto, lesão de manguito rotador, epicondilite.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🦶</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Tornozelos e Pés</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Fasciíte plantar, entorse de tornozelo, tendinite de Aquiles e desequilíbrios posturais.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🏥</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Pós-operatório</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Reabilitação após cirurgias ortopédicas: joelho, quadril, ombro, coluna.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🤰</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Gestantes e Pós-parto</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Alívio das dores musculoesqueléticas da gravidez e recuperação funcional do assoalho pélvico.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>👴</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Saúde do Idoso</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Manutenção da mobilidade, equilíbrio e força para prevenir quedas e garantir independência funcional.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🧍</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Postura e Desequilíbrios</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Hipercifose, hiperlordose, discrepância de membros e desequilíbrios musculares crônicos.</p></div><div style='background:rgba(255,255,255,.07);border:1px solid rgba(201,168,112,.2);border-radius:8px;padding:1.8rem;'><span style='font-size:1.8rem;display:block;margin-bottom:.9rem;'>🏃</span><h4 style='color:#fff;font-size:1rem;margin-bottom:.4rem;'>Lesões Esportivas</h4><p style='color:rgba(255,255,255,.55);font-size:.85rem;line-height:1.7;'>Reabilitação e retorno ao esporte com segurança — para atletas amadores e profissionais.</p></div></div>" }, "elements": [] }
        ] }
      ]
    },
