            { "id": "wf000013", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C9A870;'>Você se identifica?</p>" }, "elements": [] },
            { "id": "wf000014", "elType": "widget", "widgetType": "heading", "settings": { "title": "Está convivendo com uma dor que não passa?", "header_size": "h2", "title_color": "#3B2A1E", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 38 } }, "elements": [] },
            { "id": "wf000015", "elType": "widget", "widgetType": "divider", "settings": { "color": "#C9A870", "width": { "unit": "px", "size": 60 }, "gap": { "unit": "px", "size": 20 } }, "elements": [] },
            { "id": "wf000016", "elType": "widget", "widgetType": "icon-list", "settings": {
                "icon_list": [
                  { "_id": "fi01", "text": "Sente dor na coluna, pescoço ou ombros ao acordar ou no final do dia", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi02", "text": "Já tomou remédio, descansou — mas a dor voltou igual ou pior", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi03", "text": "A dor te impede de trabalhar, praticar exercícios ou fazer atividades simples", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi04", "text": "Passou por médicos e exames, mas o tratamento não resolveu de vez", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi05", "text": "Sente formigamento, pontadas ou limitação de movimento no dia a dia", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi06", "text": "Está em recuperação após cirurgia ortopédica e quer voltar à vida normal", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi07", "text": "Percebeu que sua postura piorou e isso está causando desconforto constante", "icon": { "value": "fas fa-arrow-right", "library": "solid" } },
                  { "_id": "fi08", "text": "Te disseram para \"aprender a conviver\" — e você não aceita isso", "icon": { "value": "fas fa-arrow-right", "library": "solid" } }
                ],
                "icon_color": "#C9A870",
                "text_color": "#5C4A3A"
              }, "elements": [] },
            { "id": "wf000017", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='background:#F5EDD6;border-left:3px solid #C9A870;padding:1.2rem 1.8rem;border-radius:0 6px 6px 0;'><p style='color:#5C4A3A;'>Se você se identificou com algum desses cenários, saiba que existe um <strong>caminho diferente</strong>. Um tratamento que vai além do alívio temporário e trata a <strong>origem do problema</strong>.</p></div>" }, "elements": [] }
          ]
        },
        {
          "id": "cf000007",
          "elType": "column",
          "settings": { "_column_size": 50 },
