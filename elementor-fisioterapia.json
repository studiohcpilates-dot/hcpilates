            { "id": "wf000021", "elType": "widget", "widgetType": "heading", "settings": { "title": "Por que os tratamentos comuns não resolvem?", "header_size": "h2", "title_color": "#3B2A1E", "align": "center", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 38 } }, "elements": [] },
            { "id": "wf000022", "elType": "widget", "widgetType": "divider", "settings": { "color": "#C9A870", "align": "center", "width": { "unit": "px", "size": 60 }, "gap": { "unit": "px", "size": 20 } }, "elements": [] },
            { "id": "wf000023", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='text-align:center;max-width:600px;margin:0 auto;'>A maioria das abordagens trata o <em>sintoma</em> — a dor. Mas enquanto a causa estrutural não for tratada, a dor retorna.</p>" }, "elements": [] }
        ] }
      ]
