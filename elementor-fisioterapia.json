            { "id": "wf000038", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p style='font-family:Cormorant Garamond,serif;font-size:3.5rem;color:#F5EDD6;line-height:1;'>02</p><h4 style='color:#3B2A1E;font-size:1.1rem;margin-bottom:.8rem;'>Protocolo Individualizado</h4><p style='color:#7A6050;font-size:.88rem;line-height:1.8;'>Com base na avaliação, montamos um plano de tratamento específico para o seu caso. Técnicas manuais, exercícios terapêuticos e, quando indicado, integração com Pilates Clínico para potencializar os resultados.</p>" }, "elements": [] }
