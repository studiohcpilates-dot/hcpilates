            { "id": "wp000028", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='padding:2rem;'><span style='color:#C9A870;font-size:.9rem;'>03</span><h3 style='color:#FFFFFF;font-size:1.5rem;margin:.5rem 0;font-family:Cormorant Garamond,serif;'>Pilates Terapêutico</h3><p style='color:rgba(255,255,255,.6);font-size:.9rem;line-height:1.8;'>Protocolo individualizado para pré e pós-operatório, dores crônicas, gestantes, idosos e condições específicas como hérnia de disco, escoliose e artrite. Totalmente personalizado.</p></div>" }, "elements": [] }
