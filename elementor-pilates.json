          "settings": { "_column_size": 33, "border_border": "solid", "border_color": "rgba(201,168,112,.2)", "border_width": { "unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true }, "border_radius": { "unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true } },
