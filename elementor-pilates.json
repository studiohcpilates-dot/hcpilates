            { "id": "wp000032", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>🦴 Alívio de Dores Crônicas</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Reduz dores na coluna, joelhos e quadris com exercícios precisos e seguros, trabalhando a causa do desequilíbrio.</p>" }, "elements": [] }
        ] },
        { "id": "cp000014", "elType": "column", "settings": { "_column_size": 33, "padding": { "unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true } }, "elements": [
            { "id": "wp000033", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>⚡ Fortalecimento Muscular</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Fortalece o core e os grupos musculares profundos, estabilizando articulações e prevenindo lesões.</p>" }, "elements": [] }
        ] },
