            { "id": "wp000036", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>🧠 Equilíbrio e Coordenação</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Desenvolve propriocepção, equilíbrio e coordenação motora — essencial para idosos e atletas em reabilitação.</p>" }, "elements": [] }
        ] },
        { "id": "cp000018", "elType": "column", "settings": { "_column_size": 33, "padding": { "unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true } }, "elements": [
