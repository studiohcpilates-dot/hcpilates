            { "id": "wp000024", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='padding:2rem;'><span style='color:#C9A870;font-size:.9rem;'>01</span><h3 style='color:#FFFFFF;font-size:1.5rem;margin:.5rem 0;font-family:Cormorant Garamond,serif;'>Pilates Solo</h3><p style='color:rgba(255,255,255,.6);font-size:.9rem;line-height:1.8;'>Exercícios no colchonete que trabalham o fortalecimento global, controle respiratório e consciência corporal. Ideal para iniciantes, bem-estar geral e como complemento ao Pilates em Aparelhos.</p></div>" }, "elements": [] }
