            { "id": "wp000026", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<div style='padding:2rem;'><span style='color:#C9A870;font-size:.9rem;'>02</span><h3 style='color:#FFFFFF;font-size:1.5rem;margin:.5rem 0;font-family:Cormorant Garamond,serif;'>Pilates em Aparelhos</h3><p style='color:rgba(255,255,255,.6);font-size:.9rem;line-height:1.8;'>Uso do Reformer, Cadeira e outros equipamentos para maior amplitude de movimento, resistência progressiva e reabilitação ortopédica eficiente. Permite maior especificidade no tratamento.</p></div>" }, "elements": [] }
          ]
