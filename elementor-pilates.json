            { "id": "wp000034", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<h4 style='color:#3B2A1E;'>🧍 Correção Postural</h4><p style='color:#5C4A3A;font-size:.9rem;line-height:1.7;'>Melhora o alinhamento postural, reduzindo sobrecargas na coluna e prevenindo lesões futuras no dia a dia.</p>" }, "elements": [] }
